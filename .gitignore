# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
.next/
/out/
out/

# Production
/build

# Vercel
.vercel
.vercel/

# SQLite dev database — not used (project uses PostgreSQL)
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# VS Code extensions
*.vsix

# Environment variables — never commit
# (.env.example is the committed template and is force-added below)
.env
.env.local
.env.*.local
.env*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
/src/generated/prisma
prisma/generated/

# Local-only agent instructions — guidance for coding agents, not application
# code. Kept on disk so local sessions read it; deliberately not tracked.
AGENTS.md
