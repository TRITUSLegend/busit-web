# BUSIT — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string.
# Local: you can use a local Postgres, Neon free tier, or Railway.
# Production (Neon): postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL="postgresql://..."

# NextAuth — generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your_secure_random_string_minimum_32_chars"

# Full URL of the app including protocol (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Gmail SMTP for sending email receipts.
# Use a Google App Password, NOT your Gmail account password.
# Generate one at: https://myaccount.google.com/apppasswords
# Email senders no-op silently if these are unset — the app still runs locally.
SMTP_EMAIL="your_gmail_address@gmail.com"
SMTP_PASSWORD="your_16_character_app_password"
